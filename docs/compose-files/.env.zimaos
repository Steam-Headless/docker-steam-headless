# ZimaOS / CasaOS example environment file.
# See docs/zimaos.md for setup instructions.

NAME=SteamHeadless
TZ=Pacific/Auckland
USER_LOCALES=en_US.UTF-8 UTF-8
DISPLAY=:55
SHM_SIZE=4G

# Persistent paths (adjust if your data volume uses a different mount point).
HOME_DIR=/opt/container-data/steam-headless/home
SHARED_SOCKETS_DIR=/opt/container-data/steam-headless/sockets
GAMES_DIR=/DATA/Games

# IMPORTANT: ZimaOS App Store templates may set PUID=65534 (nobody).
# Steam requires a writable home directory — use 1000:1000 unless you have
# a deliberate reason to map a different host user.
PUID=1000
PGID=1000
UMASK=000
USER_PASSWORD=password

MODE=primary

WEB_UI_MODE=vnc
ENABLE_VNC_AUDIO=true
PORT_NOVNC_WEB=8083
NEKO_NAT1TO1=

ENABLE_STEAM=true
# Leave empty for first login so the Steam window is visible.
# Re-add -silent later if you prefer a tray-only launch.
STEAM_ARGS=

ENABLE_SUNSHINE=false
SUNSHINE_USER=steam
SUNSHINE_PASS=admin

# ZimaOS hosts without /dev/uinput should keep this false.
ENABLE_EVDEV_INPUTS=false
# Use dummy X config when no physical monitor is attached.
FORCE_X11_DUMMY_CONFIG=true

NVIDIA_DRIVER_CAPABILITIES=all
NVIDIA_VISIBLE_DEVICES=all
# If Steam window fails to appear on NVIDIA hosts, try pinning driver 535.x
# (see https://github.com/Steam-Headless/docker-steam-headless/issues/207).
NVIDIA_DRIVER_VERSION=
